# Copy to `.env` and fill in. `.env` is git-ignored and must never be committed.
#
# SAS token for the personal user output container (campus-user).
# Obtain from the course cluster; it grants read/write to your own container only.
AZURE_USER_SAS_TOKEN=

# Optional: override the auto-detected cluster username (defaults to the OS user
# with any @domain suffix stripped).
# GHCN_USERNAME=abc123
